{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Task Management API",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"server",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Task Management Frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"client",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Task Management Website",
			"dependsOn": [
				"Run Task Management API",
				"Run Task Management Frontend"
			],
			"dependsOrder": "parallel",
			"group": "build"
		}
	]
}